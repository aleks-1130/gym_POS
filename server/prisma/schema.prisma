// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("STAFF") // OWNER, ADMIN, STAFF
  createdAt DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   // e.g. "ROLE_CHANGE", "LOGIN", "DELETE_PRODUCT"
  performedBy String   // Email or ID of user
  target      String?  // Target entity (e.g. "User: bob@gym.com")
  details     String?
  timestamp   DateTime @default(now())
}

model Member {
  id               Int                @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String?            @unique
  password         String?            // For member portal login
  phone            String?
  status           String             @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  planId           Int?
  plan             Plan?              @relation(fields: [planId], references: [id])
  startDate        DateTime           @default(now())
  expiryDate       DateTime?
  lastCheckIn      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  points           Int                @default(0)
  payments         Payment[]
  accessLogs       AccessLog[]
  bookings         Booking[]
  orders           Order[]
  trainingSessions TrainingSession[]
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  duration    Int      // Duration in days
  members     Member[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      String   // MEMBERSHIP, POS, etc.
  method    String   // CASH, CARD
  status    String   @default("COMPLETED")
  date      DateTime @default(now())
  memberId  Int?
  member    Member?  @relation(fields: [memberId], references: [id])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  checkIn   DateTime @default(now())
  status    String   @default("ALLOWED") // ALLOWED, DENIED
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // SUPPLEMENT, MERCH, DRINK
  price       Float
  stock       Int      @default(0)
  minStock    Int      @default(5)
  sku         String?  @unique
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Trainer {
  id               Int               @id @default(autoincrement())
  name             String
  specialty        String
  specialization   String?
  email            String?
  phone            String?
  bio              String?
  imageUrl         String?
  experience       Int?              // years of experience
  rating           Float?            @default(5.0)
  sessionPrice     Float             @default(50.0)
  availableSlots   Int?              @default(5)
  specialties      String?           // comma-separated list
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  classes          Class[]
  trainingSessions TrainingSession[]
}

model TrainingSession {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  trainerId Int
  trainer   Trainer  @relation(fields: [trainerId], references: [id])
  date      DateTime
  duration  Int      // minutes
  price     Float
  status    String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id          Int      @id @default(autoincrement())
  name        String
  trainerId   Int
  trainer     Trainer  @relation(fields: [trainerId], references: [id])
  dayOfWeek   String   // e.g., "Monday"
  time        String   // e.g., "10:00 AM"
  duration    Int      // minutes
  capacity    Int
  enrolled    Int      @default(0)

  createdAt   DateTime @default(now())
  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  status    String   @default("CONFIRMED") // CONFIRMED, CANCELLED, ATTENDED
  createdAt DateTime @default(now())
}

model Order {
  id        Int         @id @default(autoincrement())
  memberId  Int
  member    Member      @relation(fields: [memberId], references: [id])
  total     Float
  status    String      @default("COMPLETED")
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // Price at time of purchase
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   // ALERT, INFO, PROMO
  date      DateTime @default(now())
  read      Boolean  @default(false)
}

model LoyaltyReward {
  id          Int      @id @default(autoincrement())
  name        String
  cost        Int      // points needed
  description String?
  imageUrl    String?
  category    String?  // MERCHANDISE, SUPPLEMENT, APPAREL, EXPERIENCE
  createdAt   DateTime @default(now())
}
