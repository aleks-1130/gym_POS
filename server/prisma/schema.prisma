generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrainerType {
  FREELANCER
  FULLTIME
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  name        String?
  role        String       @default("STAFF")
  baseSalary  Float        @default(0.0)
  trainerId   Int?         @unique
  createdAt   DateTime     @default(now())
  memberNotes MemberNote[]
  payments    Payment[]    @relation("PaymentCashier")
  trainer     Trainer?     @relation("TrainerUser", fields: [trainerId], references: [id])
  expenses    Expense[]    @relation("StaffExpense")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  performedBy String
  target      String?
  details     String?
  timestamp   DateTime @default(now())
}

model Member {
  id                     Int                @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String?            @unique
  password               String?
  phone                  String?
  status                 String             @default("ACTIVE")
  planId                 Int?
  startDate              DateTime           @default(now())
  expiryDate             DateTime?
  lastCheckIn            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  points                 Int                @default(0)
  freezeStartDate        DateTime?
  freezeEndDate          DateTime?
  birthDate              DateTime?
  sex                    String?
  imageUrl               String?
  classSessionsPurchased Int                @default(0)
  classSessionsRemaining Int                @default(0)
  classSessionsUsed      Int                @default(0)
  accessLogs             AccessLog[]
  bookings               Booking[]
  plan                   Plan?              @relation(fields: [planId], references: [id])
  notes                  MemberNote[]
  membershipPeriods      MembershipPeriod[]
  orders                 Order[]
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  trainingSessions       TrainingSession[]

  @@index([status])
  @@index([createdAt])
  @@index([planId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  amount         Float
  type           String
  method         String
  status         String        @default("COMPLETED")
  date           DateTime      @default(now())
  memberId       Int?
  cashierId      Int?
  pointsAwarded  Int           @default(0)
  pointsReversed Int           @default(0)
  refundedAmount Float         @default(0)
  cashTendered   Float?
  changeDue      Float?
  externalRef    String?
  externalDate   DateTime?
  discount       Float         @default(0)
  cashier        User?         @relation("PaymentCashier", fields: [cashierId], references: [id])
  member         Member?       @relation(fields: [memberId], references: [id])
  items          PaymentItem[]

  @@index([date])
  @@index([type])
  @@index([memberId])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  memberId  Int?
  trainerId Int?
  checkIn   DateTime @default(now())
  status    String   @default("ALLOWED")
  member    Member?  @relation(fields: [memberId], references: [id])
  trainer   Trainer? @relation(fields: [trainerId], references: [id])

  @@index([checkIn])
  @@index([memberId])
  @@index([trainerId])
}

model Expense {
  id                     Int       @id @default(autoincrement())
  title                  String
  amount                 Float
  category               String
  date                   DateTime  @default(now())
  recurring              Boolean   @default(false)
  frequency              String?
  notes                  String?
  recordedBy             String?
  supplierId             Int?
  createdAt              DateTime  @default(now())
  inventoryTransactionId Int?
  supplier               Supplier? @relation(fields: [supplierId], references: [id])
  trainerId              Int?
  trainer                Trainer?  @relation(fields: [trainerId], references: [id])
  staffId                Int?
  staff                  User?     @relation("StaffExpense", fields: [staffId], references: [id])

  @@index([date])
}

model TrainingSession {
  id             Int               @id @default(autoincrement())
  memberId       Int
  trainerId      Int
  date           DateTime
  duration       Int
  price          Float
  status         String            @default("SCHEDULED")
  commissionPaid Boolean           @default(false)
  materialsCost  Float             @default(0.0)
  paymentStatus  String            @default("PAID")
  paymentMethod  String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  materials      SessionMaterial[]
  member         Member            @relation(fields: [memberId], references: [id])
  trainer        Trainer           @relation(fields: [trainerId], references: [id])

  @@index([date])
  @@index([trainerId])
  @@index([memberId])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  memberId  Int
  type      String
  last4     String
  brand     String?
  expiry    String?
  token     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id])
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  duration    Int      // Duration in days
  includesClasses      Boolean @default(false)
  includedClassSessions Int    @default(0)
  members     Member[]
  membershipPeriods MembershipPeriod[]
}

model ClassSessionPackage {
  id        Int      @id @default(autoincrement())
  name      String
  sessions  Int
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





model PaymentItem {
  id               Int      @id @default(autoincrement())
  paymentId        Int
  productId        Int?
  name             String
  type             String
  quantity         Int
  unitPrice        Float
  returnedQuantity Int      @default(0)
  payment          Payment  @relation(fields: [paymentId], references: [id])
  product          Product? @relation(fields: [productId], references: [id])
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
  products  Product[]
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  category         String
  price            Float
  stock            Int               @default(0)
  minStock         Int               @default(5)
  sku              String?           @unique
  imageUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  supplierId       Int?
  supplyCost       Float             @default(0)
  orderItems       OrderItem[]
  paymentItems     PaymentItem[]
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  sessionMaterials SessionMaterial[]
}

model Trainer {
  id               Int               @id @default(autoincrement())
  name             String
  type             TrainerType       @default(FULLTIME)
  specialty        String
  specialization   String?
  email            String?
  phone            String?
  bio              String?
  imageUrl         String?
  experience       Int?
  rating           Float?            @default(5.0)
  sessionPrice     Float             @default(50.0)
  commissionRate   Float             @default(0.0)
  baseSalary       Float             @default(0.0)
  sessionDurations String            @default("60")
  availableSlots   Int?              @default(5)
  specialties      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  classes          Class[]
  classHistory     ClassHistory[]
  trainingSessions TrainingSession[]
  user             User?             @relation("TrainerUser")
  expenses         Expense[]
  accessLogs       AccessLog[]
}

model SessionMaterial {
  id          Int             @id @default(autoincrement())
  sessionId   Int
  productId   Int?
  name        String
  category    String
  quantity    Int             @default(1)
  costPerUnit Float
  totalCost   Float
  createdAt   DateTime        @default(now())
  product     Product?        @relation(fields: [productId], references: [id])
  session     TrainingSession @relation(fields: [sessionId], references: [id])
}

model Class {
  id        Int       @id @default(autoincrement())
  name      String
  trainerId Int
  dayOfWeek String
  time      String
  duration  Int
  capacity  Int
  enrolled  Int       @default(0)
  createdAt DateTime  @default(now())
  bookings  Booking[]
  trainer   Trainer   @relation(fields: [trainerId], references: [id])
  history   ClassHistory[]
}

model ClassHistory {
  id               Int      @id @default(autoincrement())
  classId          Int
  trainerId        Int
  date             DateTime @default(now())
  attendeeCount    Int
  commissionAmount Float
  commissionPaid   Boolean  @default(false)
  createdAt        DateTime @default(now())
  
  class            Class    @relation(fields: [classId], references: [id])
  trainer          Trainer  @relation(fields: [trainerId], references: [id])

  @@index([date])
  @@index([trainerId])
}

model Booking {
  id        Int      @id @default(autoincrement())
  memberId  Int
  classId   Int
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
}

model Order {
  id        Int         @id @default(autoincrement())
  memberId  Int
  total     Float
  status    String      @default("COMPLETED")
  createdAt DateTime    @default(now())
  member    Member      @relation(fields: [memberId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model MembershipPeriod {
  id        Int      @id @default(autoincrement())
  memberId  Int
  planId    Int?
  startDate DateTime
  endDate   DateTime
  amount    Float?
  method    String?
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id])
  plan      Plan?    @relation(fields: [planId], references: [id])
}

model LoyaltyReward {
  id          Int      @id @default(autoincrement())
  name        String
  cost        Int
  description String?
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
}

model PosConfig {
  id            Int      @id @default(autoincrement())
  voidPinHash   String?
  returnPinHash String?
  updatedAt     DateTime @updatedAt
}

model Notification {
  id      Int      @id @default(autoincrement())
  title   String
  message String
  type    String
  date    DateTime @default(now())
  read    Boolean  @default(false)
}

model MemberNote {
  id        Int      @id @default(autoincrement())
  memberId  Int
  content   String
  createdAt DateTime @default(now())
  createdBy Int?
  user      User?    @relation(fields: [createdBy], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
}

model GymProfile {
  id        Int      @id @default(autoincrement())
  name      String   @default("FitOS Gym")
  address   String?  @default("123 Fitness Blvd, Gym City")
  phone     String?  @default("(555) 123-4567")
  email     String?  @default("contact@fitos.com")
  website   String?  @default("www.fitos.com")
  updatedAt DateTime @updatedAt
}


model PayrollConfig {
  id                   Int      @id @default(1)
  classBasePay         Float    @default(350.0)
  classBonusPerStudent Float    @default(30.0)
  classBonusThreshold  Int      @default(5)
  lastUpdatedBy        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("payroll_config")
}
