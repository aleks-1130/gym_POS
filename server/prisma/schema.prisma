generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int      @id @default(autoincrement())
  tenantId  String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gyms      Gym[]
  users     User[]
}

model Gym {
  id                      Int                      @id @default(autoincrement())
  tenantId                Int
  companyId               String                   @unique
  name                    String
  address                 String?
  phone                   String?
  email                   String?
  website                 String?
  currency                String                   @default("PHP")
  taxRate                 Float                    @default(12.0)
  roundingRule            String                   @default("NONE")
  timezone                String                   @default("Asia/Manila")
  referencePrefix         String                   @default("A321")
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accessLogs              AccessLog[]
  auditLogs               AuditLog[]
  bookings                Booking[]
  categories              Category[]
  classes                 Class[]
  classHistory            ClassHistory[]
  classSessions           ClassSession[]
  classPackages           ClassSessionPackage[]
  coupons                 Coupon[]
  expenses                Expense[]
  financialInstitutions   FinancialInstitution[]
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  gymProfiles             GymProfile[]
  loyaltyRewards          LoyaltyReward[]
  loyaltyTransactions     LoyaltyTransaction[]
  members                 Member[]
  memberNotes             MemberNote[]
  membershipPeriods       MembershipPeriod[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  orders                  Order[]
  orderItems              OrderItem[]
  payments                Payment[]
  paymentItems            PaymentItem[]
  productStocks           ProductStock[]
  paymentCollections      PaymentCollection[]
  paymentMethods          PaymentMethod[]
  plans                   Plan[]
  posConfigs              PosConfig[]
  products                Product[]
  promoCodes              PromoCode[]
  sessionMaterials        SessionMaterial[]
  stockOrders             StockOrder[]
  stockOrderItems         StockOrderItem[]
  suppliers               Supplier[]
  trainers                Trainer[]
  trainerAvailabilities   TrainerAvailability[]
  changeRequests          TrainerChangeRequest[]
  trainingSessions        TrainingSession[]
  users                   User[]
  payrollConfigs          PayrollConfig[]
  receiptSettings         ReceiptSettings[]

  @@index([tenantId])
}

model FinancialInstitution {
  id                     Int      @id @default(autoincrement())
  gymId                  Int
  method                 String
  financialInstitutionId String
  label                  String
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  gym                    Gym      @relation(fields: [gymId], references: [id])

  @@unique([gymId, method])
}

model PaymentCollection {
  id                     Int      @id @default(autoincrement())
  paymentId              Int
  amount                 Float
  financialInstitutionId String
  method                 String
  createdAt              DateTime @default(now())
  gymId                  Int?
  gym                    Gym?     @relation(fields: [gymId], references: [id])
  payment                Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([gymId])
}

model User {
  id                                 Int                     @id @default(autoincrement())
  email                              String                  @unique
  password                           String
  name                               String?
  role                               String                  @default("STAFF")
  trainerId                          Int?                    @unique
  createdAt                          DateTime                @default(now())
  baseSalary                         Float                   @default(0.0)
  loyaltyPoints                      Int                     @default(0)
  activationExpires                  DateTime?
  activationToken                    String?                 @unique
  status                             String                  @default("ACTIVE")
  resetPasswordExpires               DateTime?
  resetPasswordToken                 String?                 @unique
  sessionVersion                     Int                     @default(0)
  gymId                              Int?
  tenantId                           Int?
  expenses                           Expense[]               @relation("StaffExpense")
  memberNotes                        MemberNote[]
  notificationPreference             NotificationPreference?
  payments                           Payment[]               @relation("PaymentCashier")
  stockOrdersCreated                 StockOrder[]            @relation("StockOrderCreator")
  trainerChangeRequestsAdminReviewed TrainerChangeRequest[]  @relation("TrainerChangeAdminDecisionBy")
  trainerChangeRequestsOwnerReviewed TrainerChangeRequest[]  @relation("TrainerChangeOwnerDecisionBy")
  trainerChangeRequestsSubmitted     TrainerChangeRequest[]  @relation("TrainerChangeRequestedBy")
  gym                                Gym?                    @relation(fields: [gymId], references: [id])
  tenant                             Tenant?                 @relation(fields: [tenantId], references: [id])
  trainer                            Trainer?                @relation("TrainerUser", fields: [trainerId], references: [id])

  @@unique([email, gymId])
  @@index([tenantId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  performedBy String
  target      String?
  details     String?
  timestamp   DateTime @default(now())
  gymId       Int?
  gym         Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model Member {
  id                     Int                     @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String?                 @unique
  password               String?
  phone                  String?
  status                 String                  @default("ACTIVE")
  planId                 Int?
  startDate              DateTime                @default(now())
  expiryDate             DateTime?
  lastCheckIn            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  points                 Int                     @default(0)
  freezeStartDate        DateTime?
  freezeEndDate          DateTime?
  birthDate              DateTime?
  sex                    String?
  imageUrl               String?
  classSessionsPurchased Int                     @default(0)
  classSessionsRemaining Int                     @default(0)
  classSessionsUsed      Int                     @default(0)
  activationExpires      DateTime?
  activationToken        String?                 @unique
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?                 @unique
  sessionVersion         Int                     @default(0)
  freezeUsedCount        Int                     @default(0)
  gymId                  Int?
  accessLogs             AccessLog[]
  bookings               Booking[]
  coupons                Coupon[]
  loyaltyTransactions    LoyaltyTransaction[]
  gym                    Gym?                    @relation(fields: [gymId], references: [id])
  plan                   Plan?                   @relation(fields: [planId], references: [id])
  notes                  MemberNote[]
  membershipPeriods      MembershipPeriod[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  orders                 Order[]
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  trainingSessions       TrainingSession[]

  @@unique([email, gymId])
  @@index([status])
  @@index([createdAt])
  @@index([planId])
  @@index([gymId])
}

model Payment {
  id                     Int                 @id @default(autoincrement())
  amount                 Float
  type                   String
  method                 String
  status                 String              @default("COMPLETED")
  date                   DateTime            @default(now())
  memberId               Int?
  cashierId              Int?
  pointsAwarded          Int                 @default(0)
  pointsReversed         Int                 @default(0)
  refundedAmount         Float               @default(0)
  cashTendered           Float?
  changeDue              Float?
  externalRef            String?
  externalDate           DateTime?
  discount               Float               @default(0)
  couponCode             String?             // Added to trace applied coupons
  couponDiscount         Float               @default(0) // Added for explicit receipt breakdown
  companyId              String?
  currency               String              @default("PHP")
  financialInstitutionId String?
  payableAmount          Float               @default(0)
  referenceId            String?
  roundingAdjustment     Float               @default(0)
  taxAmount              Float               @default(0)
  taxableAmount          Float               @default(0)
  gymId                  Int?
  cashier                User?               @relation("PaymentCashier", fields: [cashierId], references: [id])
  gym                    Gym?                @relation(fields: [gymId], references: [id])
  member                 Member?             @relation(fields: [memberId], references: [id])
  collections            PaymentCollection[]
  items                  PaymentItem[]

  @@unique([companyId, referenceId])
  @@index([date])
  @@index([type])
  @@index([memberId])
  @@index([referenceId])
  @@index([gymId])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  memberId  Int?
  checkIn   DateTime @default(now())
  status    String   @default("ALLOWED")
  trainerId Int?
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])
  member    Member?  @relation(fields: [memberId], references: [id])
  trainer   Trainer? @relation(fields: [trainerId], references: [id])

  @@index([checkIn])
  @@index([memberId])
  @@index([trainerId])
  @@index([gymId])
}

model Expense {
  id                     Int       @id @default(autoincrement())
  title                  String
  amount                 Float
  category               String
  date                   DateTime  @default(now())
  recurring              Boolean   @default(false)
  frequency              String?
  notes                  String?
  recordedBy             String?
  supplierId             Int?
  createdAt              DateTime  @default(now())
  inventoryTransactionId Int?
  staffId                Int?
  trainerId              Int?
  gymId                  Int?
  gym                    Gym?      @relation(fields: [gymId], references: [id])
  staff                  User?     @relation("StaffExpense", fields: [staffId], references: [id])
  supplier               Supplier? @relation(fields: [supplierId], references: [id])
  trainer                Trainer?  @relation(fields: [trainerId], references: [id])

  @@index([date])
  @@index([gymId])
}

model TrainingSession {
  id                   Int               @id @default(autoincrement())
  memberId             Int
  trainerId            Int
  date                 DateTime
  duration             Int
  price                Float
  status               String            @default("SCHEDULED")
  commissionPaid       Boolean           @default(false)
  materialsCost        Float             @default(0.0)
  paymentStatus        String            @default("PAID")
  paymentMethod        String?
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  memberRatedAt        DateTime?
  memberRating         Int?
  memberRatingComment  String?
  memberRatingVoided   Boolean           @default(false)
  memberRatingVoidedAt DateTime?
  reminderSent         Boolean           @default(false)
  finalReminderSent    Boolean           @default(false)
  gymId                Int?
  materials            SessionMaterial[]
  gym                  Gym?              @relation(fields: [gymId], references: [id])
  member               Member            @relation(fields: [memberId], references: [id])
  trainer              Trainer           @relation(fields: [trainerId], references: [id])

  @@index([date])
  @@index([trainerId])
  @@index([memberId])
  @@index([gymId])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  memberId  Int
  type      String
  last4     String
  brand     String?
  expiry    String?
  token     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
}

model Plan {
  id                    Int                @id @default(autoincrement())
  name                  String
  price                 Float
  duration              Int
  includedClassSessions Int                @default(0)
  includesClasses       Boolean            @default(false)
  freezeLimitCount      Int                @default(0)
  gymId                 Int?
  members               Member[]
  membershipPeriods     MembershipPeriod[]
  gym                   Gym?               @relation(fields: [gymId], references: [id])

  @@unique([name, gymId])
}

model ClassSessionPackage {
  id        Int      @id @default(autoincrement())
  name      String
  sessions  Int
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])
}

model PaymentItem {
  id                         Int      @id @default(autoincrement())
  paymentId                  Int
  productId                  Int?
  name                       String
  type                       String
  quantity                   Int
  unitPrice                  Float
  returnedQuantity           Int      @default(0)
  intendedForSessionMaterial Boolean  @default(false)
  materialUsedQuantity       Int      @default(0)
  materialSettledQuantity    Int      @default(0)
  gymId                      Int?
  gym                        Gym?     @relation(fields: [gymId], references: [id])
  payment                    Payment  @relation(fields: [paymentId], references: [id])
  product                    Product? @relation(fields: [productId], references: [id])

  @@index([gymId])
}

model Supplier {
  id          Int          @id @default(autoincrement())
  name        String
  contact     String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gymId       Int?
  expenses    Expense[]
  products    Product[]
  productStocks ProductStock[]
  stockOrders StockOrder[]
  gym         Gym?         @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  category         String
  price            Float
  stock            Int               @default(0)
  minStock         Int               @default(5)
  sku              String?
  imageUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  supplierId       Int?
  supplyCost       Float             @default(0)
  description      String?
  gymId            Int?
  orderItems       OrderItem[]
  paymentItems     PaymentItem[]
  gym              Gym?              @relation(fields: [gymId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  sessionMaterials SessionMaterial[]
  isGlobal         Boolean           @default(false)
  stockOrderItems  StockOrderItem[]
  stocks           ProductStock[]

  @@unique([sku, gymId])
  @@index([gymId])
}

model ProductStock {
  id          Int      @id @default(autoincrement())
  productId   Int
  gymId       Int
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  supplierId  Int?
  supplyCost  Float    @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([productId, gymId])
  @@index([gymId])
  @@index([productId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gymId       Int?
  gym         Gym?     @relation(fields: [gymId], references: [id])

  @@unique([name, gymId])
}

model StockOrder {
  id             Int              @id @default(autoincrement())
  orderNumber    String
  supplierId     Int
  status         String           @default("PENDING")
  notes          String?
  createdBy      Int?
  subtotal       Float            @default(0)
  totalQuantity  Int              @default(0)
  totalLineItems Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  receivedAt     DateTime?
  cancelledAt    DateTime?
  gymId          Int?
  creator        User?            @relation("StockOrderCreator", fields: [createdBy], references: [id])
  gym            Gym?             @relation(fields: [gymId], references: [id])
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  items          StockOrderItem[]

  @@unique([orderNumber, gymId])
  @@index([createdAt])
  @@index([status])
  @@index([supplierId])
  @@index([gymId])
}

model StockOrderItem {
  id           Int        @id @default(autoincrement())
  stockOrderId Int
  productId    Int?
  name         String
  barcode      String?
  imageUrl     String?
  category     String
  quantity     Int
  cost         Float
  gymId        Int?
  gym          Gym?       @relation(fields: [gymId], references: [id])
  product      Product?   @relation(fields: [productId], references: [id])
  stockOrder   StockOrder @relation(fields: [stockOrderId], references: [id])

  @@index([stockOrderId])
  @@index([productId])
  @@index([gymId])
}

model Trainer {
  id                Int                    @id @default(autoincrement())
  name              String
  specialty         String
  specialization    String?
  email             String?
  phone             String?
  bio               String?
  imageUrl          String?
  experience        Int?
  rating            Float?                 @default(0.0)
  sessionPrice      Float                  @default(50.0)
  commissionRate    Float                  @default(0.0)
  baseSalary        Float                  @default(0.0)
  sessionDurations  String                 @default("60")
  availableSlots    Int?                   @default(5)
  specialties       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  type              TrainerType            @default(FULLTIME)
  cardImageUrl      String?
  statusDescription String?
  gymId             Int?
  accessLogs        AccessLog[]
  classes           Class[]
  classHistory      ClassHistory[]
  classSessions     ClassSession[]
  expenses          Expense[]
  gym               Gym?                   @relation(fields: [gymId], references: [id])
  availability      TrainerAvailability?
  changeRequests    TrainerChangeRequest[]
  trainingSessions  TrainingSession[]
  user              User?                  @relation("TrainerUser")

  @@index([gymId])
}

model TrainerChangeRequest {
  id              Int       @id @default(autoincrement())
  trainerId       Int
  requestedById   Int?
  requestType     String    @default("PROFILE_UPDATE")
  payload         Json
  currentData     Json
  status          String    @default("PENDING_ADMIN")
  adminDecisionBy Int?
  adminDecisionAt DateTime?
  adminNote       String?
  ownerDecisionBy Int?
  ownerDecisionAt DateTime?
  ownerNote       String?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  gymId           Int?
  adminReviewer   User?     @relation("TrainerChangeAdminDecisionBy", fields: [adminDecisionBy], references: [id])
  gym             Gym?      @relation(fields: [gymId], references: [id])
  ownerReviewer   User?     @relation("TrainerChangeOwnerDecisionBy", fields: [ownerDecisionBy], references: [id])
  requestedBy     User?     @relation("TrainerChangeRequestedBy", fields: [requestedById], references: [id])
  trainer         Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([status])
  @@index([createdAt])
  @@index([gymId])
}

model TrainerAvailability {
  id        Int      @id @default(autoincrement())
  trainerId Int      @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@index([gymId])
}

model SessionMaterial {
  id          Int             @id @default(autoincrement())
  sessionId   Int
  productId   Int?
  name        String
  category    String
  quantity    Int             @default(1)
  costPerUnit Float
  totalCost   Float
  createdAt   DateTime        @default(now())
  gymId       Int?
  gym         Gym?            @relation(fields: [gymId], references: [id])
  product     Product?        @relation(fields: [productId], references: [id])
  session     TrainingSession @relation(fields: [sessionId], references: [id])

  @@index([gymId])
}

model Class {
  id           Int            @id @default(autoincrement())
  name         String
  trainerId    Int
  dayOfWeek    String
  time         String
  duration     Int
  capacity     Int
  enrolled     Int            @default(0)
  createdAt    DateTime       @default(now())
  basePay      Float          @default(0)
  oneTimeDate  DateTime?
  scheduleType String         @default("RECURRING")
  imageUrl     String?
  daysOfWeek   String         @default("")
  endDate      DateTime?
  startDate    DateTime       @default(now())
  gymId        Int?
  bookings     Booking[]
  gym          Gym?           @relation(fields: [gymId], references: [id])
  trainer      Trainer        @relation(fields: [trainerId], references: [id])
  history      ClassHistory[]
  sessions     ClassSession[]

  @@index([gymId])
}

model ClassHistory {
  id               Int      @id @default(autoincrement())
  classId          Int
  trainerId        Int
  date             DateTime @default(now())
  attendeeCount    Int
  commissionAmount Float
  commissionPaid   Boolean  @default(false)
  createdAt        DateTime @default(now())
  gymId            Int?
  class            Class    @relation(fields: [classId], references: [id])
  gym              Gym?     @relation(fields: [gymId], references: [id])
  trainer          Trainer  @relation(fields: [trainerId], references: [id])

  @@index([date])
  @@index([trainerId])
  @@index([gymId])
}

model Booking {
  id                Int       @id @default(autoincrement())
  memberId          Int
  classId           Int
  status            String    @default("CONFIRMED")
  createdAt         DateTime  @default(now())
  sessionDate       DateTime?
  reminderSent      Boolean   @default(false)
  finalReminderSent Boolean   @default(false)
  gymId             Int?
  class             Class     @relation(fields: [classId], references: [id])
  gym               Gym?      @relation(fields: [gymId], references: [id])
  member            Member    @relation(fields: [memberId], references: [id])

  @@index([classId, sessionDate])
  @@index([memberId, sessionDate])
  @@index([gymId])
}

model ClassSession {
  id              Int       @id @default(autoincrement())
  classId         Int
  trainerId       Int
  sessionDate     DateTime
  status          String    @default("SCHEDULED")
  startedAt       DateTime?
  completedAt     DateTime?
  startedByRole   String?
  completedByRole String?
  completionNote  String?
  isAutoStarted   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  gymId           Int?
  class           Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  gym             Gym?      @relation(fields: [gymId], references: [id])
  trainer         Trainer   @relation(fields: [trainerId], references: [id])

  @@unique([classId, sessionDate])
  @@index([trainerId, sessionDate])
  @@index([status, sessionDate])
  @@index([gymId])
}

model Order {
  id        Int         @id @default(autoincrement())
  memberId  Int
  total     Float
  status    String      @default("COMPLETED")
  createdAt DateTime    @default(now())
  gymId     Int?
  gym       Gym?        @relation(fields: [gymId], references: [id])
  member    Member      @relation(fields: [memberId], references: [id])
  items     OrderItem[]

  @@index([gymId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  gymId     Int?
  gym       Gym?    @relation(fields: [gymId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([gymId])
}

model MembershipPeriod {
  id        Int      @id @default(autoincrement())
  memberId  Int
  planId    Int?
  startDate DateTime
  endDate   DateTime
  amount    Float?
  method    String?
  createdAt DateTime @default(now())
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
  plan      Plan?    @relation(fields: [planId], references: [id])

  @@index([gymId])
}

model LoyaltyReward {
  id          Int      @id @default(autoincrement())
  name        String
  cost        Int
  description String?
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
  actionType  String?  @default("NONE")
  actionValue Float?
  gymId       Int?
  gym         Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  memberId    Int
  points      Int
  type        String
  description String?
  createdAt   DateTime @default(now())
  gymId       Int?
  gym         Gym?     @relation(fields: [gymId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([type])
  @@index([createdAt])
  @@index([gymId])
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String
  memberId   Int?
  type       String
  value      Float
  status     String    @default("ACTIVE")
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  gymId      Int?
  gym        Gym?      @relation(fields: [gymId], references: [id])
  member     Member?   @relation(fields: [memberId], references: [id])

  @@unique([code, gymId])
  @@index([code])
  @@index([memberId])
  @@index([status])
  @@index([gymId])
}

model PosConfig {
  id              Int      @id @default(autoincrement())
  voidPinHash     String?
  returnPinHash   String?
  updatedAt       DateTime @updatedAt
  discountPresets Json?
  gymId           Int?
  gym             Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model ReceiptSettings {
  id        Int      @id @default(autoincrement())
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@map("receipt_settings")
}

model Notification {
  id             Int      @id @default(autoincrement())
  title          String
  message        String
  type           String
  createdAt      DateTime @default(now())
  isRead         Boolean  @default(false)
  isAnnouncement Boolean  @default(false)
  targetGroup    String   @default("ALL")
  targetId       Int?
  memberId       Int?
  gymId          Int?
  gym            Gym?     @relation(fields: [gymId], references: [id])
  member         Member?  @relation(fields: [memberId], references: [id])

  @@index([gymId])
}

model MemberNote {
  id        Int      @id @default(autoincrement())
  memberId  Int
  content   String
  createdAt DateTime @default(now())
  createdBy Int?
  gymId     Int?
  user      User?    @relation(fields: [createdBy], references: [id])
  gym       Gym?     @relation(fields: [gymId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])

  @@index([gymId])
}

model GymProfile {
  id        Int      @id @default(autoincrement())
  name      String   @default("FitOS Gym")
  address   String?  @default("123 Fitness Blvd, Gym City")
  phone     String?  @default("(555) 123-4567")
  email     String?  @default("contact@fitos.com")
  website   String?  @default("www.fitos.com")
  updatedAt DateTime @updatedAt
  gymId     Int?
  gym       Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model PayrollConfig {
  id                   Int      @id @default(autoincrement())
  classBasePay         Float    @default(350.0)
  classBonusPerStudent Float    @default(30.0)
  classBonusThreshold  Int      @default(5)
  lastUpdatedBy        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  gymId                Int?
  gym                  Gym?     @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@map("payroll_config")
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String
  type        String
  value       Float
  description String?
  maxUses     Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bogoConfig  Json?
  categories  String[]  @default([])
  productIds  Int[]     @default([])
  scope       String    @default("ORDER")
  gymId       Int?
  gym         Gym?      @relation(fields: [gymId], references: [id])

  @@unique([code, gymId])
  @@index([gymId])
}

model NotificationPreference {
  id                 Int      @id @default(autoincrement())
  memberId           Int?     @unique
  userId             Int?     @unique
  emailAnnouncements Boolean  @default(true)
  emailReminders     Boolean  @default(true)
  emailReceipts      Boolean  @default(true)
  appAnnouncements   Boolean  @default(true)
  appReminders       Boolean  @default(true)
  appReceipts        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  gymId              Int?
  gym                Gym?     @relation(fields: [gymId], references: [id])
  member             Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

enum TrainerType {
  FREELANCER
  FULLTIME
}
